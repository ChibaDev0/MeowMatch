# MeowMatch — รายชื่อ environment variables (ไม่มีค่าลับจริงในไฟล์นี้)
# คัดลอกเป็น .env.local แล้วเติมค่าจาก Supabase project ของคุณ
# อ้างอิง: MeowMatch/08-api-security

# --- Supabase (ฝั่ง client, เปิดเผยได้) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase (ฝั่ง server เท่านั้น ห้ามส่งไป client) ---
# ใช้เฉพาะงานที่กำหนดชัด เช่น resolve Username ก่อน login และลบบัญชี
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- แอป ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# เปิดหลัง apply 0007 และผ่าน DB permissions/concurrency/revocation acceptance เท่านั้น
ANALYSIS_HISTORY_ENABLED="false"

# --- Gemini Flash (server only; never use NEXT_PUBLIC_ for this key) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Optional separate model for the breeding page.
GEMINI_PAIR_MODEL="gemini-3.1-flash-lite"
